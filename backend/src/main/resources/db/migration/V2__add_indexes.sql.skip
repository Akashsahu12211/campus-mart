-- ========================================
-- CAMPUS MART - DATABASE PERFORMANCE OPTIMIZATIONS
-- ========================================
-- Version: 2.0
-- Description: Add critical indexes and performance enhancements
-- Status: Applied after V1 schema creation

-- ========================================
-- ADDITIONAL INDEXES FOR PERFORMANCE
-- ========================================

-- Items: Optimize search queries
CREATE INDEX IF NOT EXISTS idx_seller_status ON items(seller_id, status);
CREATE INDEX IF NOT EXISTS idx_price_range ON items(price);

-- Messages: Optimize chat queries
CREATE INDEX IF NOT EXISTS idx_sender_receiver ON messages(sender_id, receiver_id, created_at);
CREATE INDEX IF NOT EXISTS idx_receiver_sender ON messages(receiver_id, sender_id, is_read);

-- Payment Orders: Optimize transaction queries
CREATE INDEX IF NOT EXISTS idx_buyer_status ON payment_orders(buyer_id, status);
CREATE INDEX IF NOT EXISTS idx_seller_status_payment ON payment_orders(seller_id, status);
CREATE INDEX IF NOT EXISTS idx_item_status ON payment_orders(item_id, status);

-- Students: Optimize lookup queries
CREATE INDEX IF NOT EXISTS idx_email_active ON students(email, is_active);
CREATE INDEX IF NOT EXISTS idx_phone_active ON students(phone_number, is_active);

-- Reports: Optimize admin queries
CREATE INDEX IF NOT EXISTS idx_status_created ON reports(status, created_at);

-- Reviews: Optimize ratings queries
CREATE INDEX IF NOT EXISTS idx_seller_created ON reviews(seller_id, created_at);

-- ========================================
-- PERFORMANCE ANALYSIS HINTS
-- ========================================
-- Note: If you encounter slow queries, use:
-- EXPLAIN SELECT * FROM items WHERE seller_id = 1 AND status = 'ACTIVE';
-- EXPLAIN SELECT * FROM messages WHERE receiver_id = 1 ORDER BY created_at DESC LIMIT 20;
